{
  "name": "owebstudio/kirby-pwa",
  "description": "Turns your project into a PWA (progressive web app) for Kirby.",
  "type": "kirby-plugin",
  "version": "1.0.3",
  "license": "MIT",
  "keywords": [
    "owebstudio",
    "owebstudio-plugin",
    "kirby",
    "kirby-plugin",
    "kirby-pwa",
    "pwa",
    "progressive-web-app"
  ],
  "homepage": "https://owebstudio.com",
  "support": {
    "email": "support@owebstudio.com"
  },
  "authors": [
    {
      "name": "oweb studio",
      "email": "contact@owebstudio.com",
      "homepage": "https://owebstudio.com"
    }
  ],
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "require": {
    "php": "^7.4|^8.0",
    "getkirby/composer-installer": "^1.2"
  },
  "extra": {
    "kirby": {
      "compatible": "^3.6 || ^4.0 || ^5.0"
    }
  }
}

