{
  "name": "owebstudio/kirby-pwa",
  "description": "Turns your Kirby site into a progressive web app with offline support.",
  "type": "kirby-plugin",
  "version": "2.0.0",
  "license": "MIT",
  "keywords": [
    "owebstudio",
    "owebstudio-plugin",
    "kirby",
    "kirby-plugin",
    "kirby-pwa",
    "pwa",
    "progressive-web-app",
    "service-worker",
    "offline"
  ],
  "homepage": "https://github.com/owebstudio/kirby-pwa",
  "support": {
    "issues": "https://github.com/owebstudio/kirby-pwa/issues",
    "source": "https://github.com/owebstudio/kirby-pwa"
  },
  "authors": [
    {
      "name": "oweb studio",
      "homepage": "https://github.com/owebstudio"
    }
  ],
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "require": {
    "php": "^8.2",
    "getkirby/composer-installer": "^1.2"
  },
  "extra": {
    "kirby": {
      "compatible": "^5.0 || ^6.0"
    }
  }
}
